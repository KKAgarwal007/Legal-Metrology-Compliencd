# ==============================================================================
# Legal Metrology Compliance System - Environment Template
# Copy this file to .env before starting:
#   cp .env.example .env (Linux / macOS)
#   copy .env.example .env (Windows)
# ==============================================================================

# Flask Session Security Key
APP_SECRET_KEY=dev-secret-change-me-for-production

# Supabase Database Configuration (Optional: falls back to local SQLite if empty)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Port (Default: 5000)
PORT=5000
