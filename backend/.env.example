# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legal_metrology
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/legal_metrology

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# OCR
OCR_ENGINE=paddleocr
OCR_LANG=en
OCR_CONFIDENCE_HIGH=0.90
OCR_CONFIDENCE_MEDIUM=0.60

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Security
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=Legal Metrology Compliance System
APP_VERSION=1.0.0
DEBUG=true
